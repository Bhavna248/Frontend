# MongoDB connection string (MongoDB Atlas or local)
# Atlas: put the database name before ? e.g. ...mongodb.net/intern_assign?retryWrites=true&w=majority
DB_URI=mongodb://127.0.0.1:27017/intern_assign

# API port
PORT=5000

# Optional: comma-separated allowed origins for CORS (e.g. http://localhost:5173)
# FRONTEND_ORIGIN=http://localhost:5173
