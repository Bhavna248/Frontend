# Optional: full API URL (no trailing slash). Use when the frontend is NOT served by Vite
# with a proxy to the same API — e.g. static hosting + API on another domain.
# VITE_API_URL=https://your-api.example.com

# Default: leave VITE_API_URL unset. Then the app calls /api on the same origin and
# Vite (dev + preview) proxies /api → your backend (see vite.config.js).

# If the API listens on a non-default host/port during local dev/preview:
# VITE_PROXY_TARGET=http://127.0.0.1:5000
